# Demo never sends audio or text to a paid API.
VOICE_MODE=demo
# Alternatives: whisper_cpp (requires whisper-cli + a model); demo is scripted, not STT.
VOICE_STT_BACKEND=demo
# Alternatives: espeak, browser (browser synthesis is handled in the web UI).
VOICE_TTS_BACKEND=browser
# Alternatives: openai_compatible. This option can incur provider costs.
VOICE_LLM_BACKEND=rules
VOICE_LLM_ENDPOINT=
VOICE_LLM_API_KEY=
VOICE_LLM_MODEL=
VOICE_WHISPER_EXECUTABLE=whisper-cli
VOICE_WHISPER_MODEL=
VOICE_ESPEAK_EXECUTABLE=espeak-ng
VOICE_FFMPEG_EXECUTABLE=ffmpeg
VOICE_FFPROBE_EXECUTABLE=ffprobe
VOICE_MAX_UPLOAD_BYTES=8388608
VOICE_MAX_AUDIO_SECONDS=30
VOICE_PROCESS_TIMEOUT_SECONDS=90
VOICE_MAX_HISTORY=12
VOICE_SESSION_TTL_SECONDS=1800
VOICE_TIMEZONE=America/Sao_Paulo
# Keep CORS empty for same-origin local use only.
VOICE_CORS_ORIGINS=[]
